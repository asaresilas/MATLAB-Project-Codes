# Copy this file to .env and fill in values for your environment.
# Never commit .env with real credentials to version control.

# Backend REST API base URL (no trailing slash)
VITE_API_BASE_URL=http://127.0.0.1:8000

# Backend WebSocket dashboard stream URL
VITE_WS_URL=ws://127.0.0.1:8000/ws/dashboard

# Display name shown in the top bar
VITE_APP_NAME=Induction Motor Digital Twin Console

# Default machine ID label
VITE_MACHINE_ID=SCIM-01
